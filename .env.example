# 应用基础配置（必填）
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://parlasoul_app:<db_password>@localhost:5432/parlasoul
SECRET_KEY=<replace-with-openssl-rand-hex-32>
CORS_ORIGINS=http://localhost:3001

# SMTP（必填，用于邮件相关流程）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<smtp_user>
SMTP_PASSWORD=<smtp_password>
EMAILS_FROM_EMAIL=ParlaSoul <no-reply@example.com>

# Milvus 向量数据库配置
MILVUS_URL=
MILVUS_TOKEN=
MEMORY_COLLECTION_NAME=memories_dev
MEMORY_GROUP_COLLECTION_NAME=groups_dev


# Embedding（OpenAI 兼容接口）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=qwen/qwen3-embedding-4b


# LLM Providers
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_ID=gpt-5.1-mini
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_API_BASE=
LLM_DEEPSEEK_MODEL_ID=deepseek-chat
LLM_OPENROUTER_API_KEY=
LLM_OPENROUTER_API_BASE=
LLM_OPENROUTER_MODEL_ID=openai/gpt-4.1-mini
LLM_DASHSCOPE_API_KEY=
LLM_DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DASHSCOPE_MODEL_ID=qwen3.6-flash
LLM_DASHSCOPE_CHAT_MODEL_ID=
LLM_DASHSCOPE_TITLE_MODEL_ID=
LLM_DASHSCOPE_MEMORY_MODEL_ID=
LLM_DASHSCOPE_LEARNING_MODEL_ID=
LLM_DEEPSEEK_MODELS=
LLM_OPENROUTER_MODELS_CACHE_SECONDS=

# DashScope（Qwen 实时语音）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_WEBSOCKET_API_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
DASHSCOPE_STT_REALTIME_WEBSOCKET_API_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_TTS_WEBSOCKET_API_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_TTS_CUSTOMIZATION_API_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/customization
DASHSCOPE_STT_MODEL=qwen3-asr-flash-realtime
DASHSCOPE_STT_HTTP_MODEL=qwen-audio-3.1-asr-flash
DASHSCOPE_STT_HTTP_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_STT_HTTP_TIMEOUT_SECONDS=20
DASHSCOPE_STT_LANGUAGE_HINTS=zh,en
DASHSCOPE_STT_CONTEXT_MAX_TURNS=3
DASHSCOPE_TTS_MODEL=qwen3-tts-instruct-flash-realtime
DASHSCOPE_TTS_LANGUAGE_TYPE=English
DASHSCOPE_BILLING_REGION=
DASHSCOPE_VOICE_ENROLLMENT_MODEL=qwen-voice-enrollment
DASHSCOPE_VOICE_CLONE_TARGET_MODEL=qwen3-tts-vc-realtime-2026-01-15
DASHSCOPE_HTTP_TIMEOUT_SECONDS=30
DASHSCOPE_TIMBRE_LIST_DOC_URL=https://help.aliyun.com/zh/model-studio/multimodal-timbre-list
DASHSCOPE_TIMBRE_LIST_CACHE_SECONDS=600

# MiniMax（普通聊天 TTS）
MINIMAX_TTS_API_KEY=
MINIMAX_TTS_WEBSOCKET_API_URL=wss://api.minimaxi.com/ws/v1/t2a_v2
MINIMAX_TTS_MODEL_ID=speech-2.8-turbo
MINIMAX_TTS_SAMPLE_RATE=24000
MINIMAX_TTS_BITRATE=128000
MINIMAX_TTS_CHANNEL=1
MINIMAX_TTS_DEFAULT_SPEED=1.0
MINIMAX_TTS_DEFAULT_VOLUME=1.0
MINIMAX_TTS_DEFAULT_PITCH=0
MINIMAX_TTS_EVENT_TIMEOUT_SECONDS=30.0
MINIMAX_TTS_OPEN_TIMEOUT_SECONDS=15.0
MINIMAX_TTS_WARM_CONNECTION_ENABLED=true
MINIMAX_TTS_WARM_CONNECTION_TTL_SECONDS=105
MINIMAX_TTS_WARM_CONNECTION_WAIT_SECONDS=3
MINIMAX_TTS_WARM_CONNECTION_KEEPALIVE_SECONDS=900
MINIMAX_TTS_WARM_CONNECTION_REFRESH_MARGIN_SECONDS=20

REALTIME_VAD_MODEL_PATH=models/silero_vad.onnx
REALTIME_VAD_SAMPLE_RATE=16000
REALTIME_VAD_THRESHOLD=0.5
REALTIME_VAD_END_THRESHOLD_DELTA=0.15
REALTIME_VAD_MIN_SILENCE_MS=600
REALTIME_VAD_SPEECH_PAD_MS=30
REALTIME_VAD_PRE_ROLL_MS=300
REALTIME_AUDIO_PACER_PREBUFFER_MS=200
REALTIME_AUDIO_PACER_RECOVERY_PREBUFFER_MS=60
REALTIME_AUDIO_PACER_FADEOUT_MS=50
REALTIME_AUDIO_PACER_MAX_BUFFER_MS=2000
REALTIME_AUDIO_DEBUG_CAPTURE_ENABLED=false
REALTIME_AUDIO_DEBUG_CAPTURE_DIR=tmp/realtime-audio-debug
REALTIME_AUDIO_DEBUG_CAPTURE_MAX_BYTES_PER_FILE=50000000
REALTIME_UTTERANCE_COMMIT_GRACE_MS=200
REALTIME_UTTERANCE_MIN_AUDIO_MS=300
REALTIME_UTTERANCE_MIN_VOICED_MS=200
REALTIME_INTERRUPT_HARD_CONFIRM_MS=300
REALTIME_INTERRUPT_RESUME_GRACE_MS=250
REALTIME_BACKCHANNEL_MAX_VOICED_MS=900
REALTIME_BACKCHANNEL_MAX_WAIT_MS=500
REALTIME_TTS_FIRST_SEGMENT_TIMEOUT_MS=300
REALTIME_TTS_LATER_SEGMENT_TIMEOUT_MS=700
REALTIME_TTS_FIRST_SEGMENT_TARGET_CHARS=28
REALTIME_TTS_LATER_SEGMENT_MIN_CHARS=40
REALTIME_TTS_LATER_SEGMENT_MAX_CHARS=160

# Realtime WebRTC / TURN
# Development:
# - public URLs are consumed by the browser, so they may point at a reachable public coturn.
# - backend URLs are consumed by local aiortc. Keep empty unless you have a local/backend-reachable TURN path.
# Production:
# - public URLs should point at the public TURN domain.
# - backend URLs should point at the backend/container-reachable TURN address.
REALTIME_ICE_PUBLIC_URLS=
REALTIME_ICE_BACKEND_URLS=
REALTIME_TURN_SECRET=
REALTIME_TURN_REALM=parlasoul.com
REALTIME_TURN_USERNAME_PREFIX=parlasoul
REALTIME_TURN_CREDENTIAL_TTL_SECONDS=3600
REALTIME_NEGOTIATION_TIMEOUT_SECONDS=5.0
# coturn 部署时使用（后端进程本身不会消费）
REALTIME_TURN_EXTERNAL_IP=
REALTIME_TURN_RELAY_IP=

# LLM（请求与重试）
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_SECONDS=1

# Langfuse 监控配置
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_ENABLED=false


# 其他配置
K_SEMANTIC=5
K_EPISODIC=5
USE_ALL_SEMANTIC=true
NARRATIVE_SIMILARITY_THRESHOLD=0.8
CHAT_HISTORY_LIMIT=20
MEMORY_WARMUP_TIMEOUT_SECONDS=15
ENABLE_PROACTIVE_MESSAGE_JOB=false
PROACTIVE_JOB_SCAN_INTERVAL_SECONDS=60
PROACTIVE_JOB_IDLE_SLEEP_SECONDS=5
PROACTIVE_JOB_WORKER_COUNT=3
PROACTIVE_JOB_DISPATCH_LEASE_SECONDS=180
PROACTIVE_JOB_MAX_RETRIES=3
PROACTIVE_JOB_RETRY_BASE_DELAY_SECONDS=60
PROACTIVE_JOB_MIN_MEMORY_COUNT=3
PROACTIVE_JOB_ACTIVITY_CAP=50
PROACTIVE_JOB_COOLDOWN_CAP_DAYS=7
PROACTIVE_JOB_ACTIVITY_WINDOW_DAYS=7
PROACTIVE_JOB_MAX_EPISODIC_MEMORIES=50
PROACTIVE_JOB_SLOT_HOURS=10,15,21
USER_SETTINGS_AUTO_READ_ALOUD_ENABLED_DEFAULT=true
BETTER_AUTH_JWKS_URL=http://localhost:3001/api/auth/jwks
BETTER_AUTH_JWT_ISSUER=http://localhost:3001
BETTER_AUTH_JWT_AUDIENCE=http://localhost:3001

# Media storage (Cloudflare R2 + Redis)
REDIS_URL=redis://localhost:6380/0
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET_NAME=your-media-bucket
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://<public-bucket-id>.r2.dev
MEDIA_PUBLIC_BASE_URL=/media
MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/avif
MEDIA_IMAGE_VARIANTS=96,192,512
MEDIA_IMAGE_FORMAT=avif
MEDIA_IMAGE_QUALITY=55
MEDIA_MAX_UPLOAD_BYTES=5242880
MEDIA_IMAGE_MAX_PIXELS=16777216
MEDIA_UPLOAD_SESSION_TTL_SECONDS=900
MEDIA_CACHE_MAX_BYTES=262144
MEDIA_CACHE_TTL_SECONDS=604800
MEDIA_CACHE_NEGATIVE_TTL_SECONDS=60
MEDIA_PRESIGNED_URL_TTL_SECONDS=900

# Dodo Payments
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_SUBSCRIPTION_WEBHOOK_SECRET=
DODO_PAYMENTS_PAYMENT_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_WEB_APP_BASE_URL=http://localhost:3001
BILLING_PAYWALL_ENABLED=false
BILLING_CHECKOUT_ENABLED=false
DODO_SUBSCRIPTION_PLUS_PRODUCT_IDS=
DODO_SUBSCRIPTION_PRO_PRODUCT_IDS=
DODO_WECHAT_PLUS_30D_PRODUCT_ID=<dodo_product_id>
DODO_WECHAT_PRO_30D_PRODUCT_ID=<dodo_product_id>
DODO_WECHAT_PLUS_365D_PRODUCT_ID=<dodo_product_id>
DODO_WECHAT_PRO_365D_PRODUCT_ID=<dodo_product_id>
